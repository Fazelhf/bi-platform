# Copy to .env for local development.
# Leave DATABASE_URL unset to use SQLite (zero-config local dev).

DEBUG=True
SECRET_KEY=dev-insecure-change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (used by docker-compose). Comment out to fall back to SQLite.
# DATABASE_URL=postgres://bi:bi@localhost:5432/bi

# Redis / Celery (optional for local dev)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//

# CORS for the Vue dev server
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
