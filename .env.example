# Root env for docker-compose. Copy to .env before `docker compose up`.

# --- Django ---
DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:8080

# --- CRM demo ---
# Password for the locked «دمو CRM» section. Separate from any login password,
# so the demo can be shown without handing over an account.
# Defaults to 1484 in settings.py — a simple gate, not a secret, since it ships
# in the source. Set a different value here if the demo ever needs to be closed
# to people who can read the repository. An empty value closes it completely.
CRM_DEMO_PASSWORD=

# --- SMS / ورود دو مرحله‌ای (ملی‌پیامک) ---
# Two-step login sends its one-time code through the Melipayamak SendOtp
# endpoint. Leave these blank and 2FA simply cannot be switched on (in DEBUG
# the code is printed to the console instead, so the flow still works locally).
#
# SMS_PASSWORD is the panel's **ApiKey**, not the account password — the panel
# can be configured to require it (it answers -110 otherwise), and it is
# rotatable on its own.
#
# SMS_MODE picks which of the panel's two send methods this account may use:
#   otp    → SendOtp. Needs SMS_FROM, your own sender line. The message text
#            («کد تایید شما / Code: 123456») belongs to the endpoint, so there
#            is no template to register.
#   shared → BaseServiceNumber, for a خط خدماتی اشتراکی. No sender number;
#            instead SMS_BODY_ID is the id of a template you registered under
#            «توسعه‌دهندگان › وب‌سرویس خدماتی (الگو)» and the panel approved.
#            The template needs exactly one variable — the code goes there.
#
# If the panel has an allowed-IP list, the server's outbound address must be on
# it, or EVERY call (even ones that send nothing) comes back -111.
SMS_USERNAME=
SMS_PASSWORD=
SMS_MODE=otp
SMS_FROM=
SMS_BODY_ID=
# Defaults are fine; override only to point at the SOAP endpoint or to tune.
# SMS_BASE_URL=https://rest.payamak-panel.com/api/SendSMS
# OTP_TTL_SECONDS=180
# OTP_MAX_ATTEMPTS=5
# OTP_MAX_SENDS=3
# OTP_RESEND_COOLDOWN=60

# --- Postgres ---
POSTGRES_DB=bi
POSTGRES_USER=bi
POSTGRES_PASSWORD=bi

# --- RabbitMQ ---
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
